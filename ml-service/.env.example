APP_ENV=dev
# Must equal ML_SERVICE_TOKEN in backend/.env. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ML_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
# Optional. Defaults: dev=false (load on first request), prod=true (load at startup).
# PRELOAD_MODEL=true
# PORT=8001
