APP_ENV=dev
DATABASE_URL=postgresql://REPLACE_WITH_YOUR_SUPABASE_SESSION_POOLER_URI
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:5173
# Optional additional origins, comma-separated. Localhost and 127.0.0.1 are aliased.
FRONTEND_ORIGINS=
# Supabase: replace DATABASE_URL with Connect > Session pooler URI.
# postgres:// and postgresql:// are normalized to the psycopg driver automatically.
# Supabase connections default to sslmode=require; explicit SSL options are preserved.
UPLOAD_DIR=uploads
# Images in Docker local storage persist in the uploads volume.
# Optional override. Defaults: dev=local, prod=supabase.
# IMAGE_STORAGE=supabase
SUPABASE_URL=
# Legacy service_role key from Supabase Settings > API; backend only, never VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=wardrobe-images
EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
# Private scoring parameters; never use VITE_ prefixes for these.
BUSINESS_RULES_JSON={"weights":{"semantic":0.45,"color":0.35,"texture":0.2},"neutral_saturation":0.16,"neutral_value_low":0.2,"analogous_degrees":40,"complementary_tolerance":35,"max_candidates":8,"max_combinations":12000,"texture_pairs":{"cotton:denim":0.95,"knit:denim":0.9,"leather:denim":0.9,"cotton:linen":0.95},"neutral_score":0.9,"complementary_score":0.9,"triadic_score":0.8,"unmatched_color_score":0.35,"same_texture_score":0.85,"unknown_texture_score":0.6,"analogous_falloff_degrees":180}
